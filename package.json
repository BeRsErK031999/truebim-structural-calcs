    "release:evidence": "node scripts/generate-release-evidence.mjs",
    "deploy:precheck": "powershell -ExecutionPolicy Bypass -File scripts/deploy-precheck.ps1",
    "deploy:build": "powershell -ExecutionPolicy Bypass -File scripts/build-image.ps1",
    "deploy:export": "powershell -ExecutionPolicy Bypass -File scripts/export-image.ps1",
    "deploy:package": "powershell -ExecutionPolicy Bypass -File scripts/build-image.ps1 && powershell -ExecutionPolicy Bypass -File scripts/export-image.ps1"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.4.0",
